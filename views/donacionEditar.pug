extends layout

block content
  article.formulario-card
    h3 Editar Donación
    p.subtitulo-detalle ID Donación: ##{donacion.idDonacion} (solo lectura)

    form(action=`/vistas/donaciones/${donacion.idDonacion}/editar` method="POST")
      div
        label(for="monto") Monto ($)
        input(type="number" step="0.01" name="monto" id="monto" value=donacion.monto required)

      div
        label(for="cbu") CBU / Cuenta
        input(type="text" name="cbu" id="cbu" value=donacion.cbu required)

      div
        label(for="fecha") Fecha (YYYY-MM-DD)
        input(type="date" name="fecha" id="fecha" value=donacion.fecha.toISOString().slice(0, 10) required)

      div
        label(for="idProyecto") Proyecto
        select(name="idProyecto" id="idProyecto" required)
          option(value="") Seleccioná un proyecto...
          each proyecto in proyectos
            option(value=proyecto.idProyecto selected=(proyecto.idProyecto === donacion.idProyecto))= proyecto.nomProyecto

      div
        label(for="idDonante") Donante
        select(name="idDonante" id="idDonante" required)
          option(value="") Seleccioná un donante...
          each donante in donantes
            option(value=donante.idDonante selected=(donante.idDonante === donacion.idDonante))= `${donante.nombre} ${donante.apellido}`

      div
        label(for="idOrganizacion") Organización
        select(name="idOrganizacion" id="idOrganizacion" required)
          option(value="") Seleccioná una organización...
          each org in organizaciones
            option(value=org.idOrganizacion selected=(org.idOrganizacion === donacion.idOrganizacion))= org.nombre

      .form-actions
        a.btn-secundario(href="/vistas/donaciones") Cancelar
        button(type="submit") Guardar Cambios
