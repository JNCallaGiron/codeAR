extends layout

block content
  article.formulario-card
    h3 Detalle de la Donación

    table
      tr
        th.num ID Donación
        td.num= donacion.idDonacion
      tr
        th.num Monto
        td.num $ #{donacion.monto}
      tr
        th CBU
        td= donacion.cbu
      tr
        th Fecha
        td= donacion.fecha.toISOString().slice(0, 10)
      tr
        th Proyecto
        td= proyecto ? `${proyecto.nomProyecto} (#${donacion.idProyecto})` : `(#${donacion.idProyecto})`
      tr
        th Donante
        td= donante ? `${donante.nombre} ${donante.apellido} (#${donacion.idDonante})` : `(#${donacion.idDonante})`
      tr
        th Organización
        td= organizacion ? `${organizacion.nombre} (#${donacion.idOrganizacion})` : `(#${donacion.idOrganizacion})`

    p.acciones-detalle
      a.btn-secundario(href="/vistas/donaciones") Volver al listado
      if currentUser && currentUser.role === 'admin'
        a.btn-secundario(href=`/vistas/donaciones/${donacion.idDonacion}/editar`) Editar
