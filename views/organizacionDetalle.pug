extends layout

block content
  fieldset
    legend Detalle de la Organización

    if organizacion
      table.tabla-detalle
        tr
          th Nombre
          td= organizacion.nombre
        tr
          th Tipo
          td= organizacion.tipo
        tr
          th CUIL
          td.num= organizacion.cuil
        tr
          th Teléfono
          td.num= organizacion.telefono
        tr
          th Email
          td= organizacion.mail
        tr
          th Dirección
          td= organizacion.direccion
        tr
          th Responsable
          td= organizacion.responsable

      p.acciones-detalle
        if currentUser && currentUser.role === 'admin'
          a.btn-secundario(href=`/vistas/organizaciones/${organizacion.idOrganizacion}/editar`) Editar
          a.btn-peligro(href=`/vistas/organizaciones/${organizacion.idOrganizacion}/eliminar`) Dar de baja
        a.btn-secundario(href="/vistas/organizaciones") Volver al listado
    else
      p Organización no encontrada.
