extends layout

block content
  fieldset
    legend Control de Gastos
    if currentUser && currentUser.role === 'admin'
      p.acciones-detalle
        a.btn-primario(href="/vistas/gastos/nuevo") + Nuevo Gasto
    
    if gastos && gastos.length > 0
      table
        thead
          tr
            th ID Gasto
            th Proyecto
            th Descripción
            th.num Monto
            th Fecha
            th.acciones Acciones
        tbody
          each gasto in gastos
            tr
              td= gasto.idGasto
              td= gasto.nombreProyecto || gasto.idProyecto
              td= gasto.descripcion
              td.num $#{gasto.monto}
              td= gasto.fecha.toISOString().slice(0, 10)
              td.acciones
                a(href=`/vistas/gastos/${gasto.idGasto}`) Ver detalle
                if currentUser && currentUser.role === 'admin'
                  a(href=`/vistas/gastos/${gasto.idGasto}/editar`) Editar
                  a(href=`/vistas/gastos/${gasto.idGasto}/eliminar`) Eliminar
    else
      p No hay gastos registrados.